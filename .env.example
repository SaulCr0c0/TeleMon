# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube al repositorio.

# --- Broker MQTT (Mosquitto y broker propio) ---
MQTT_PORT=1883
MQTT_USER_ESP32=esp32
MQTT_PASS_ESP32=cambiar
MQTT_USER_NODERED=nodered
MQTT_PASS_NODERED=cambiar
# Formato del broker propio: usuario:clave,usuario:clave
BROKER_USERS=esp32:cambiar,nodered:cambiar
BROKER_PROPIO_PORT=1884
BROKER_LOG=INFO

# --- PostgreSQL ---
POSTGRES_DB=telemon
POSTGRES_USER=telemon
POSTGRES_PASSWORD=cambiar

# --- Sesión (token JWT): poner un texto largo al azar, ej. openssl rand -hex 32 ---
JWT_SECRETO=cambiar-por-un-texto-largo-al-azar

# --- Web ---
DOMINIO=telematicos2026.online
